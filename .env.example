# Database Configuration
# Change these values for your local environment
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/ecclesiastic_db
SPRING_DATASOURCE_USERNAME=ecclesiastic_user
SPRING_DATASOURCE_PASSWORD=your_secure_db_password_here

# JWT Secret
# Generate a strong secret key in production
# Minimum 256 bits recommended
JWT_SECRET=your-super-secret-jwt-key-change-in-production-minimum-256-bits

# Spring Profile (dev, test, prod)
SPRING_PROFILES_ACTIVE=dev