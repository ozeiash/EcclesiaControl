# Database Configuration
# Change these values for your local environment
POSTGRES_DB=ecclesiastic_db
POSTGRES_USER=ecclesiastic_user
POSTGRES_PASSWORD=troque_esta_senha
JWT_SECRET=gere_com_openssl_rand_base64_64
ENCRYPT_KEY=gere_com_openssl_rand_base64_32

# JWT Secret
# Generate a strong secret key in production
# Minimum 256 bits recommended
JWT_SECRET=your-super-secret-jwt-key-change-in-production-minimum-256-bits

# Spring Profile (dev, test, prod)
SPRING_PROFILES_ACTIVE=dev