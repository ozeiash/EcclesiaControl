# EcclesiaControl: variáveis de ambiente
# Copie para ".env" e substitua TODOS os valores. Nunca versione o ".env".

# Banco de dados (PostgreSQL)
POSTGRES_DB=ecclesiastic_db
POSTGRES_USER=ecclesiastic_user
POSTGRES_PASSWORD=troque_esta_senha

# Segredo de assinatura do JWT (HS512): mínimo de 64 caracteres.
# Gere com: openssl rand -base64 64 | tr -d '\n'
JWT_SECRET=gere_com_openssl_rand_base64_64

# Chave AES-GCM (32 bytes em Base64) que cifra CPF e RG.
# Gere com: openssl rand -base64 32
ENCRYPT_KEY=gere_com_openssl_rand_base64_32

# Perfil do Spring: dev (local) ou prod
SPRING_PROFILES_ACTIVE=dev